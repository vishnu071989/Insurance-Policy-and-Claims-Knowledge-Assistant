# Copy to .env. No secrets here: AWS credentials come from the standard AWS chain
# (aws configure / AWS_PROFILE / IAM role).
AWS_REGION=us-east-1
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# REQUIRED: a Claude model ID or inference-profile ID enabled for your account/region in Bedrock
LLM_MODEL_ID=
TOP_K=5
MIN_SCORE=0.30
# Role used by the MCP server process (claims_handler | policy_servicing | customer_support)
MCP_USER_ROLE=customer_support
